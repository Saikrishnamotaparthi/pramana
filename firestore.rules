rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to get user role safely
    function getUserRole() {
       let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
       return userDoc != null ? userDoc.data.role : null;
    }

    function isViewAdmin() {
      let role = getUserRole();
      return role in ['view_admin', 'admin', 'superadmin', 'entry_admin', 'marketing_admin'];
    }

    // Helper for specific admin writes
    function isAdminOrSuper() {
      let role = getUserRole();
      return role == 'admin' || role == 'superadmin';
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isViewAdmin();
      allow write: if isOwner(userId) || isAdminOrSuper();
    }
    
    // Config
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdminOrSuper();
    }
    
    // Passes Config
    match /passes_config/{passId} {
      allow read: if true;
      allow write: if isAdminOrSuper();
    }
    
    // Coupons 
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdminOrSuper();
    }
    
    function isPpassAdmin() {
      return getUserRole() == 'ppass_admin';
    }

    // Passes Issued
    match /passes_issued/{passId} {
      allow read: if request.auth != null && (
        resource.data.purchasedBy == request.auth.uid || 
        resource.data.issuedToEmail == request.auth.token.email || 
        isViewAdmin() || isPpassAdmin()
      );
      allow write: if isAdminOrSuper() || isPpassAdmin(); 
    }

    // Cultural Events & Registrations
    match /culturals/{userId} {
      // Allow reading the user profile doc
      // Explicitly allow cul_admin
      allow read: if request.auth != null && (request.auth.uid == userId || isViewAdmin() || getUserRole() == 'cul_admin');
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Subcollection: Registrations
      match /registrations/{regId} {
         allow read: if request.auth != null && (request.auth.uid == userId || isViewAdmin() || getUserRole() == 'cul_admin');
         allow create: if request.auth != null &&(request.auth.uid == userId || isViewAdmin()); 
         allow update: if isViewAdmin() || getUserRole() == 'cul_admin';
         allow delete: if isAdminOrSuper();
      }
    }
    
    // Collection Group Query for 'registrations'
    // This is crucial for the Admin Panel to see ALL registrations
    match /{path=**}/registrations/{regId} {
      allow read: if isViewAdmin() || getUserRole() == 'cul_admin';
    }

    // Settings Collection (Payment Links)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdminOrSuper();
    }

    // Referral Codes
    match /referral_codes/{codeId} {
      allow read: if request.auth != null;
      allow write: if isAdminOrSuper() || getUserRole() == 'marketing_admin';
    }
    // Bulk Pass Configurations
    match /bulk_pass_configs/{configId} {
      allow read: if true;
      allow write: if isAdminOrSuper();
    }
    
    // Bulk Pass Requests
    match /bulk_pass_requests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        resource.data.mainUserEmail == request.auth.token.email || 
        request.auth.token.email in resource.data.memberEmails ||
        isAdminOrSuper()
      );
      allow update: if isAdminOrSuper();
    }
  }
}